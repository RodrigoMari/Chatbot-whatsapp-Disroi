generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model reclamo {
  id              BigInt           @id @default(autoincrement())
  fecha_tiempo    DateTime         @default(now())
  cliente         String?          @db.VarChar(10)
  tipo            String?          @default("")
  cod_factura     Int?
  estado          reclamo_estado?  @default(PENDIENTE)
  tomado_por      String?          @db.VarChar(30)
  fecha_tomado    DateTime?        @db.DateTime(0)
  archivoPdf      String?          @db.VarChar(255)
  observacion     String?          @db.VarChar(300)
  info_resolucion String?          @db.LongText
  paso            paso[]
  maestro_21      maestro_cliente? @relation(fields: [cliente], references: [codigo], onDelete: Restrict, onUpdate: Restrict, map: "fk_cliente_codigo")
  reclamo_area    reclamo_area[]

  @@index([cliente], map: "fk_cliente_codigo")
}

model maestro_cliente {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique(map: "idx_codigo") @db.VarChar(10)
  nombre     String?   @db.VarChar(50)
  dni        String?   @db.VarChar(13)
  cuit       String?   @db.VarChar(15)
  vendedor_1 String?   @db.VarChar(2)
  vendedor_2 String?   @db.VarChar(2)
  estado     String?   @db.VarChar(10)
  telefono   String?   @db.VarChar(20)
  reclamo    reclamo[]
}

model reclamo_area {
  id         Int     @id @default(autoincrement())
  reclamo_Id BigInt
  area       String  @db.VarChar(50)
  reclamo    reclamo @relation(fields: [reclamo_Id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reclamo_area_ibfk_1")

  @@index([reclamo_Id], map: "reclamoId")
}

model suscripciones {
  id             Int       @id @default(autoincrement())
  endpoint       String    @db.Text
  expirationTime DateTime? @db.DateTime(0)
  p256dh         String    @db.Text
  auth           String    @db.VarChar(255)
  area           String    @db.VarChar(100)
  nombre         String    @db.VarChar(100)
  ip             String    @db.VarChar(45)
  created_at     DateTime  @default(now()) @db.Timestamp(0)
}

model vendedor {
  id       Int     @id @default(autoincrement())
  codigo   String  @unique(map: "codigo") @db.VarChar(2)
  nombre   String  @db.VarChar(50)
  telefono String? @db.VarChar(20)
}

model paso {
  id          BigInt    @id @default(autoincrement())
  descripcion String    @db.VarChar(500)
  fecha       DateTime? @default(now()) @db.DateTime(0)
  reclamoId   BigInt
  tipo        paso_tipo @default(ANALISIS)
  area_paso   String?   @db.VarChar(20)
  persona     String?   @db.VarChar(30)
  foto        String?   @db.VarChar(255)
  reclamo     reclamo   @relation(fields: [reclamoId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_paso_reclamo")

  @@index([reclamoId], map: "reclamoId")
}

enum reclamo_estado {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  EMPTY_ENUM_VALUE @map("")
}

enum paso_tipo {
  ANALISIS
  INFORMACION
  FINALIZACION
}
