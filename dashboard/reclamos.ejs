<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Gestión de Reclamos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="text-dark">

  <div id="pre-subscribe" class="d-flex flex-column justify-content-center align-items-center vh-100">
    <h2 class="mb-3 text-white">Ingresa tu nombre y seleccioná tu área para continuar</h2>
    <input type="text" id="nombre" class="form-control mb-3 mx-auto" placeholder="Ingresa tu nombre" style="width: 200px;">
    <select id="area" class="form-select mb-3" style="width: 200px;">
      <option value="">Selecciona tu área</option>
      <option value="VENTAS">VENTAS</option>
      <option value="DEPOSITO">DEPOSITO</option>
      <option value="ADMINISTRACION">ADMINISTRACION</option>
      <option value="RRHH">RRHH</option>
      <option value="GC">GC</option>
    </select>

    <button id="subscribe" class="btn btn-primary">Suscribirme</button>
  </div>

  <script>
    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - base64String.length % 4) % 4);
      const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      const rawData = atob(base64);
      return Uint8Array.from([...rawData].map(char => char.charCodeAt(0)));
    }

    async function checkSubscription() {
      try {
        const registration = await navigator.serviceWorker.getRegistration();
        if (!registration) return false;
        
        const subscription = await registration.pushManager.getSubscription();
        if (!subscription) return false;
        
        const res = await fetch(`/check-subscription?endpoint=${encodeURIComponent(subscription.endpoint)}`);
        if (!res.ok) throw new Error('Error verificando suscripción');
        const data = await res.json();
        return data.exists;
      } catch (err) {
        console.error(err);
        return false;
      }
    }

    async function init() {
      const exists = await checkSubscription();
      if (exists) {
        document.getElementById('pre-subscribe').classList.add('d-none');
        document.getElementById('main-content').classList.remove('d-none');
      }
    }

    async function subscribePush(areaSeleccionada, nombreSeleccionado) {
      if (!('serviceWorker' in navigator && 'PushManager' in window)) {
        alert('Tu navegador no soporta notificaciones push.');
        return;
      }

      try {
        const registration = await navigator.serviceWorker.register('/sw.js');
        console.log('Service Worker registrado');

        let subscription = await registration.pushManager.getSubscription();
        if (!subscription) {
          const response = await fetch('/vapidPublicKey');
          if (!response.ok) throw new Error('No se pudo obtener la clave VAPID');

          const vapidPublicKey = await response.text();
          const convertedVapidKey = urlBase64ToUint8Array(vapidPublicKey);

          subscription = await registration.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: convertedVapidKey
          });
        }

        const res = await fetch('/subscribe', {
          method: 'POST',
          body: JSON.stringify({ subscription, area: areaSeleccionada, nombre: nombreSeleccionado }),
          headers: { 'Content-Type': 'application/json' }
        });

        if (!res.ok) throw new Error('Error al enviar la suscripción al servidor');

        // Suscripción exitosa: ocultar pantalla de pre-suscripción y mostrar contenido principal
        document.getElementById('pre-subscribe').classList.add('d-none');
        document.getElementById('main-content').classList.remove('d-none');

      } catch (err) {
        console.error('Error durante la suscripción:', err);
        alert('Ocurrió un error al suscribirse. Intenta nuevamente.');
      }
    }

    document.getElementById('subscribe').addEventListener('click', () => {
      const area = document.getElementById('area').value;
      const nombre = document.getElementById('nombre').value;
      if (!area || !nombre) {
        alert('Por favor ingresa tu nombre y selecciona un área antes de suscribirte.');
        return;
      }
      subscribePush(area, nombre);
    });

    window.addEventListener('load', init);
  </script>

  <div id="main-content" class="d-none"> <!-- none -->
    <div class="container my-5">
      
      <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
          <h1 class="h2 fw-bold text-white mb-0">
            <i class="bi bi-clipboard-data me-2 text-primary"></i>Gestión de Reclamos
          </h1>
        </div>
        <div class="d-flex gap-2">
          <button id="reporte" class="btn btn-primary shadow-sm rounded-pill px-3">
            <i class="bi bi-file-earmark-pdf me-1"></i> Reporte
          </button>
          <a href="/changelog" class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-flex align-items-center">Cambios</a>
        </div>
      </div>

      <form id="filter-form" method="GET" action="/reclamos" class="row g-3 mb-4 justify-content-end">
        <div class="col-auto">
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-secondary rounded-start-pill">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" name="cliente" class="form-control bg-dark text-white border-secondary px-3" 
                  placeholder="Cliente o Código..." value="<%= clienteSeleccionado %>">
            <button class="btn btn-primary rounded-end-pill" type="submit">Ir</button>
          </div>
        </div>
        <div class="col-auto d-flex gap-2">
          <div class="dropdown">
            <button class="btn btn-dark border-secondary dropdown-toggle rounded-pill px-3" type="button" id="dropdownEstados" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
              <i class="bi bi-funnel me-1"></i> Estados 
              <span class="badge bg-primary rounded-circle"><%= Array.isArray(estadoSeleccionado) ? estadoSeleccionado.length : (estadoSeleccionado ? 1 : 0) %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-dark shadow p-3" aria-labelledby="dropdownEstados">
              <% ['PENDIENTE', 'EN_PROCESO', 'COMPLETADO'].forEach(est => { 
                  const isChecked = Array.isArray(estadoSeleccionado) ? estadoSeleccionado.includes(est) : estadoSeleccionado === est;
              %>
                <li class="mb-2">
                  <label class="dropdown-item d-flex align-items-center gap-2 rounded-2 py-1" style="cursor: pointer;">
                    <input class="form-check-input mt-0" type="checkbox" name="estado" value="<%= est %>" <%= isChecked ? 'checked' : '' %>>
                    <span><%= est.replace('_', ' ') %></span>
                  </label>
                </li>
              <% }) %>
              <li><hr class="dropdown-divider"></li>
              <li><button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill">Aplicar</button></li>
            </ul>
          </div>

          <div class="dropdown">
            <button class="btn btn-dark border-secondary dropdown-toggle rounded-pill px-3" type="button" id="dropdownResponsables" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
              <i class="bi bi-person-badge me-1"></i> Responsables
              <span class="badge bg-primary rounded-circle"><%= Array.isArray(areaSeleccionada) ? areaSeleccionada.length : (areaSeleccionada ? 1 : 0) %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-dark shadow p-3" aria-labelledby="dropdownResponsables" style="min-width: 250px;">
              <% const opciones = ['AGUSTIN', 'LUCAS', 'GUSTAVO S.', 'ROBERTO', 'MIGUEL', 'DEPOSITO', 'ADMINISTRACION', 'RRHH'];
                 opciones.forEach(opt => { 
                  const isChecked = Array.isArray(areaSeleccionada) ? areaSeleccionada.includes(opt) : areaSeleccionada === opt;
              %>
                <li class="mb-2">
                  <label class="dropdown-item d-flex align-items-center gap-2 rounded-2 py-1" style="cursor: pointer;">
                    <input class="form-check-input mt-0" type="checkbox" name="area" value="<%= opt %>" <%= isChecked ? 'checked' : '' %>>
                    <span><%= opt %></span>
                  </label>
                </li>
              <% }) %>
              <li><hr class="dropdown-divider"></li>
              <li><button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill">Filtrar</button></li>
            </ul>
          </div>
          <a href="/reclamos" class="row-auto btn btn-danger shadow-sm rounded-pill px-3 d-flex align-items-center" style="text-decoration: none;">
            <i class="bi bi-trash3 me-1"></i> Borrar filtros
          </a>
        </div>
      </form>

      <div class="mb-3 d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-3">
          <span class="fw-bold text-white small">Tardanza:</span>
          <span class="d-inline-flex align-items-center text-white small"><span style="width:12px;height:12px;background:#fffb00;margin-right:5px;border-radius:2px;"></span> 24h</span>
          <span class="d-inline-flex align-items-center text-white small"><span style="width:12px;height:12px;background:#fd7e14;margin-right:5px;border-radius:2px;"></span> 48h</span>
          <span class="d-inline-flex align-items-center text-white small"><span style="width:12px;height:12px;background:#fd1e34;margin-right:5px;border-radius:2px;"></span> 72h</span>
        </div>

        <div class="d-flex align-items-center gap-3">
          <span class="fw-bold text-white">Área responsable:</span>
          <span class="d-inline-flex align-items-center text-white">
            <span style="display:inline-block;width:18px;height:18px;background:#721c24;border-radius:4px;margin-right:6px;border:1px solid #721c24;"></span>
            Ventas
          </span>
          <span class="d-inline-flex align-items-center text-white">
            <span style="display:inline-block;width:18px;height:18px;background:#155724;border-radius:4px;margin-right:6px;border:1px solid #155724;"></span>
            Administración
          </span>
          <span class="d-inline-flex align-items-center text-white">
            <span style="display:inline-block;width:18px;height:18px;background:#856404;border-radius:4px;margin-right:6px;border:1px solid #856404;"></span>
            Depósito
          </span>
          <span class="d-inline-flex align-items-center text-white">
            <span style="display:inline-block;width:18px;height:18px;background:#004085;border-radius:4px;margin-right:6px;border:1px solid #004085;"></span>
            RRHH
          </span>
        </div>
      </div>
      <div class="table-responsive shadow-lg">
        <table class="table table-hover align-middle text-center custom-table">
          <thead class="table-primary text-uppercase small">
            <tr>
              <th>Fecha</th>
              <th>ID</th>
              <th>Código</th>
              <th>Nombre</th>
              <th>Teléfono</th>
              <th>Tipo</th>
              <th>Responsable</th>
              <th>Factura</th>
              <th>Vendedor</th>
              <th>Observación</th>
              <th>Estado</th>
              <th>CV</th>
              <th>Acción</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody class="bg-white">
            <% reclamos.forEach(function(r) { %>
              <tr>
                <td class="<%= r.filaClase %>"><%= new Date(r.fecha_tiempo).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                <td><%= r.id %></td>
                <td><%= parseInt(r.cliente, 10) || "sin codigo" %></td>
                <td class="text-start"><%= r.maestro_21?.nombre || "sin nombre" %></td>
                <td><%= r.telefonoClienteConVendedor || "-" %></td>
                <td><%= r.tipo %></td>
                <td>
                  <% if (r.reclamo_area && r.reclamo_area.length > 0) { %>
                    <%- r.reclamo_area.map(a => {
                        let areaClean = a.area.replace(/[\[\]]/g, '');
                        let texto = (areaClean.toUpperCase() === 'VENTAS') ? r.nombreSupervisor : areaClean;
                        return `<span class="area-label area-${areaClean}">${texto}</span>`;
                    }).join('<br />') %>
                  <% } else { %>
                    <span class="text-muted small">Sin área</span>
                  <% } %>
                </td>
                <td><%= r.cod_factura || "-" %></td>
                <td><%= r.maestro_21?.vendedor_1 || "-" %> / <%= r.maestro_21?.vendedor_2 || "-" %></td>
                <td class="text-start small"><%= r.observacion %></td>
                <td class="estado">
                  <% if (r.estado === 'COMPLETADO') { %>
                    <span class="badge bg-success">✅</span>
                  <% } else if (r.estado === 'EN_PROCESO') { %>
                    <span class="badge bg-primary">🔄</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">⏳</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.archivoPdf) { %>
                    <a href="/reclamos/<%= r.id %>/pdf" class="btn btn-sm btn-success rounded-pill"><i class="bi bi-download"></i></a>
                  <% } else { %>
                    <i class="bi bi-x-circle text-muted"></i>
                  <% } %>
                </td>
                <td>
                  <a href="#" 
                    onclick="location.href='/reclamos/<%= r.id %>' + window.location.search; return false;" 
                    class="btn btn-outline-secondary btn-sm rounded-pill">
                    Pasos
                  </a>
                </td>
                <td>
                  <button type="button" class="btn btn-success btn-sm rounded-pill"
                    onclick='mostrarPopup(JSON.parse(decodeURIComponent("<%= encodeURIComponent(JSON.stringify(r)) %>")))'>
                    Revisar
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div id="popup-reclamo" class="popup-overlay d-none">
      <div class="popup-content shadow-lg">
        <div class="popup-header d-flex justify-content-between align-items-start">
          <h5 class="mb-0 fw-bold">Detalles del Reclamo</h5>
          <div class="text-end small">
            <p class="mb-0 text-white-50">Cerrado: <span id="popup-fecha-toma" class="text-white"></span></p>
            <p class="mb-0 text-white-50">Por: <span id="popup-usuario-toma" class="text-white"></span></p>
          </div>
        </div>

        <div class="popup-grid">
          <div><p>Fecha</p><span id="popup-fecha"></span></div>
          <div><p>ID</p><span id="popup-id"></span></div>
          <div><p>Cliente</p><span id="popup-nombre"></span> (<span id="popup-cliente"></span>)</div>
          <div><p>Teléfono</p><span id="popup-telefono"></span></div>
          <div><p>Tipo</p><span id="popup-tipo"></span></div>
          <div><p>Área</p><span id="popup-area" class="text-info"></span></div>
          <div><p>Factura</p><span id="popup-factura"></span></div>
          <div><p>Vendedor</p><span id="popup-vendedor"></span></div>
        </div>

        <div class="observacion-box">
          <p class="small mb-1 text-uppercase fw-bold">Productos y Observaciones:</p>
          <div id="popup-observacion"></div>
        </div>

        <button type="button" onclick="cerrarPopup('reclamo')" class="btn btn-close-custom w-100 mt-4 rounded-pill py-2">
          <i class="bi bi-x-circle me-1"></i> Cerrar Detalle
        </button>
      </div>
    </div>

    <div id="popup-reporte" class="popup-overlay d-none">
      <div class="popup-content" style="max-width: 400px;">
        <h4 class="text-center mb-4">Generar Reporte PDF</h4>
        <form method="GET" action="/reclamos/reporte">
          <div class="mb-3">
            <label class="form-label small">DESDE:</label>
            <input type="date" name="fecha_desde" class="form-control bg-dark text-white border-secondary" required>
          </div>
          <div class="mb-3">
            <label class="form-label small">HASTA:</label>
            <input type="date" name="fecha_hasta" class="form-control bg-dark text-white border-secondary" required>
          </div>
          <button type="submit" class="btn btn-primary w-100 mb-2">Descargar Reporte</button>
          <button type="button" onclick="cerrarPopup('reporte')" class="btn btn-outline-light w-100">Cancelar</button>
        </form>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    // MOSTRAR POPUP DETALLE
    function mostrarPopup(r) {
      document.getElementById("popup-fecha-toma").textContent = r.fecha_tomado ? r.fecha_tomado.replace("T", " ").split(".")[0] : "no tomado";
      document.getElementById("popup-usuario-toma").textContent = r.tomado_por || "no tomado";
      document.getElementById("popup-fecha").textContent = new Date(r.fecha_tiempo).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' });
      document.getElementById("popup-id").textContent = r.id;
      document.getElementById("popup-cliente").textContent = r.cliente || "sin codigo";
      document.getElementById("popup-nombre").textContent = r.maestro_21?.nombre || "sin nombre";
      document.getElementById("popup-telefono").textContent = r.maestro_21?.telefono || "sin telefono";
      document.getElementById("popup-tipo").textContent = r.tipo;
      document.getElementById("popup-area").textContent = r.nombreSupervisor || r.reclamo_area.map(a => a.area).join(', ');
      document.getElementById("popup-factura").textContent = r.cod_factura || "sin factura";
      document.getElementById("popup-vendedor").textContent = (r.maestro_21?.vendedor_1 || "sin vendedor") + " / " + (r.maestro_21?.vendedor_2 || "sin vendedor");
      document.getElementById("popup-observacion").textContent = r.observacion_completa;

      const el = document.getElementById("popup-reclamo");
      el.classList.replace('d-none', 'd-flex');
    }

    // ABRIR POPUP REPORTE
    document.getElementById('reporte').addEventListener('click', (e) => {
      e.preventDefault();
      const popup = document.getElementById('popup-reporte');
      popup.classList.replace('d-none', 'd-flex');
    });

    // CERRAR POPUPS
    function cerrarPopup(tipo) {
      const id = tipo === 'reporte' ? 'popup-reporte' : 'popup-reclamo';
      const el = document.getElementById(id);
      el.classList.replace('d-flex', 'd-none');
    }

    // URL LIMPIA (FILTROS CON COMAS)
    document.getElementById('filter-form').addEventListener('submit', function(e) {
      e.preventDefault();
      const formData = new FormData(this);
      const params = new URLSearchParams();
      const dataMap = {};

      formData.forEach((value, key) => {
        if (!value) return; // Ignorar vacíos

        if (key === 'cliente') {
          // El cliente es búsqueda simple, no lleva comas usualmente
          params.set(key, value);
        } else {
          // Estados y Áreas se siguen agrupando
          if (!dataMap[key]) dataMap[key] = [];
          dataMap[key].push(value);
        }
      });

      // Procesar los grupos (estados, áreas)
      for (const key in dataMap) {
        if (dataMap[key].length > 0) params.set(key, dataMap[key].join(','));
      }

      window.location.href = window.location.pathname + '?' + params.toString();
    });

    // SOCKET.IO
    const socket = io();
    socket.on("estadoActualizado", () => location.reload());

  </script>
</body>
</html>