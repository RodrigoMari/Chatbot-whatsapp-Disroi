<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Gestión de Reclamos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-light text-dark" >
  <div id="pre-subscribe" class="d-flex flex-column justify-content-center align-items-center vh-100">
    <h2 class="mb-3">Ingresa tu nombre y seleccioná tu área para continuar</h2>
    <input type="text" id="nombre" class="form-control mb-3 mx-auto" placeholder="Ingresa tu nombre" style="width: 200px;">
    <select id="area" class="form-select mb-3" style="width: 200px;">
      <option value="">Selecciona tu área</option>
      <option value="VENTAS">VENTAS</option>
      <option value="DEPOSITO">DEPOSITO</option>
      <option value="ADMINISTRACION">ADMINISTRACION</option>
      <option value="RRHH">RRHH</option>
      <option value="GC">GC</option>
    </select>

    <button id="subscribe" class="btn btn-primary">Suscribirme</button>
  </div>

  <script>
    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - base64String.length % 4) % 4);
      const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      const rawData = atob(base64);
      return Uint8Array.from([...rawData].map(char => char.charCodeAt(0)));
    }

    async function checkSubscription() {
      try {
        const registration = await navigator.serviceWorker.getRegistration();
        if (!registration) return false;
        
        const subscription = await registration.pushManager.getSubscription();
        if (!subscription) return false;
        
        const res = await fetch(`/check-subscription?endpoint=${encodeURIComponent(subscription.endpoint)}`);
        if (!res.ok) throw new Error('Error verificando suscripción');
        const data = await res.json();
        return data.exists;
      } catch (err) {
        console.error(err);
        return false;
      }
    }

    async function init() {
      const exists = await checkSubscription();
      if (exists) {
        document.getElementById('pre-subscribe').classList.add('d-none');
        document.getElementById('main-content').classList.remove('d-none');
      }
    }

    async function subscribePush(areaSeleccionada, nombreSeleccionado) {
      if (!('serviceWorker' in navigator && 'PushManager' in window)) {
        alert('Tu navegador no soporta notificaciones push.');
        return;
      }

      try {
        const registration = await navigator.serviceWorker.register('/sw.js');
        console.log('Service Worker registrado');

        let subscription = await registration.pushManager.getSubscription();
        if (!subscription) {
          const response = await fetch('/vapidPublicKey');
          if (!response.ok) throw new Error('No se pudo obtener la clave VAPID');

          const vapidPublicKey = await response.text();
          const convertedVapidKey = urlBase64ToUint8Array(vapidPublicKey);

          subscription = await registration.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: convertedVapidKey
          });
        }

        const res = await fetch('/subscribe', {
          method: 'POST',
          body: JSON.stringify({ subscription, area: areaSeleccionada, nombre: nombreSeleccionado }),
          headers: { 'Content-Type': 'application/json' }
        });

        if (!res.ok) throw new Error('Error al enviar la suscripción al servidor');

        // Suscripción exitosa: ocultar pantalla de pre-suscripción y mostrar contenido principal
        document.getElementById('pre-subscribe').classList.add('d-none');
        document.getElementById('main-content').classList.remove('d-none');

      } catch (err) {
        console.error('Error durante la suscripción:', err);
        alert('Ocurrió un error al suscribirse. Intenta nuevamente.');
      }
    }

    document.getElementById('subscribe').addEventListener('click', () => {
      const area = document.getElementById('area').value;
      const nombre = document.getElementById('nombre').value;
      if (!area || !nombre) {
        alert('Por favor ingresa tu nombre y selecciona un área antes de suscribirte.');
        return;
      }
      subscribePush(area, nombre);
    });

    window.addEventListener('load', init);
  </script>


  <div id="main-content" class="d-none">
    <div class="container my-5">
      <h1 class="text-center fw-bold mb-4">Gestión de Reclamos</h1>
      <button id="reporte" class="btn btn-primary mb-3">Generar Reporte</button>
      <div id="popup-reporte" class="popup-overlay d-none">
      <div class="popup-content">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h5>Generar Reporte de Reclamos</h5>
          <button type="button" onclick="cerrarPopup('reporte')" class="btn btn-secondary">❌</button>
        </div>
        <form id="popup-form-reporte" method="GET" action="/reclamos/reporte">
          <div class="mb-3">
            <label for="fecha-desde" class="form-label">Fecha desde:</label>
            <input type="date" id="fecha-desde" name="fecha_desde" class="form-control">
          </div>
          <div class="mb-3">
            <label for="fecha-hasta" class="form-label">Fecha hasta:</label>
            <input type="date" id="fecha-hasta" name="fecha_hasta" class="form-control">
          </div>
          <button type="submit" class="btn btn-primary w-100">Generar Reporte</button>
        </form>
        </div>
      </div>
      <!-- Filtro de estado -->
      <form method="GET" action="/reclamos" class="d-flex justify-content-end mb-4">
        <select class="form-select filtro-estado" name="estado" onchange="this.form.submit()">
          <option value="">Todos los estados</option>
          <option value="PENDIENTE" <%= estadoSeleccionado === 'PENDIENTE' ? 'selected' : '' %>>PENDIENTE</option>
          <option value="EN_PROCESO" <%= estadoSeleccionado === 'EN_PROCESO' ? 'selected' : '' %>>EN PROCESO</option>
          <option value="COMPLETADO" <%= estadoSeleccionado === 'COMPLETADO' ? 'selected' : '' %>>COMPLETADO</option>
        </select>

      <!-- Filtro de area -->
        <select class="form-select filtro-area" name="area" onchange="this.form.submit()">
          <option value="">Todas las áreas</option>
          <option value="VENTAS" <%= areaSeleccionada === 'VENTAS' ? 'selected' : '' %>>VENTAS</option>
          <option value="DEPOSITO" <%= areaSeleccionada === 'DEPOSITO' ? 'selected' : '' %>>DEPOSITO</option>
          <option value="ADMINISTRACION" <%= areaSeleccionada === 'ADMINISTRACION' ? 'selected' : '' %>>ADMINISTRACION</option>
          <option value="RRHH" <%= areaSeleccionada === 'RRHH' ? 'selected' : '' %>>RRHH</option>
        </select>
      </form>

      <!-- Leyenda de estados por tardanza -->
      <div class="mb-3 d-flex align-items-center gap-3">
        <span class="fw-bold">Tardanza:</span>
        <span class="d-inline-flex align-items-center">
          <span style="display:inline-block;width:18px;height:18px;background:#fffb00;border-radius:4px;margin-right:6px;border:1px solid #fffb00;"></span>
          24h
        </span>
        <span class="d-inline-flex align-items-center">
          <span style="display:inline-block;width:18px;height:18px;background:#fd7e14;border-radius:4px;margin-right:6px;border:1px solid #fd7e14;"></span>
          48h
        </span>
        <span class="d-inline-flex align-items-center">
          <span style="display:inline-block;width:18px;height:18px;background:#fd1e34;border-radius:4px;margin-right:6px;border:1px solid #fd1e34;"></span>
          72h
        </span>
      </div>

      <div class="table-responsive">
        <table class="table table-bordered table-hover bg-white align-middle text-center">
          <thead class="table-primary text-uppercase">
            <tr>
              <th>Fecha</th>
              <th>ID</th>
              <th>Código</th>
              <th>Nombre</th>
              <th>Teléfono</th>
              <th>Tipo</th>
              <th>Área</th>
              <th>Factura</th>
              <th>Vendedor</th>
              <th>Observación</th>
              <th>Estado</th>
              <th>CV</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody>
            <% reclamos.forEach(function(r) { %>
              <tr>
                <td class="<%= r.filaClase %>"><%= new Date(r.fecha_tiempo).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                <td><%= r.id %></td>
                <td><%= parseInt(r.cliente, 10) || "sin codigo" %></td>
                <td><%= r.maestro_21?.nombre || "sin nombre" %></td>
                <td><%= /\d/.test(r.maestro_21?.telefono || "") ? r.maestro_21.telefono : "sin telefono" %></td>
                <td><%= r.tipo %></td>
                <td><%- r.reclamo_area.map(a => a.area).join('<br />') %></td>
                <td><%= r.cod_factura || "sin factura" %></td>
                <td><%= r.maestro_21?.vendedor_1 || "-" %> / <%= r.maestro_21?.vendedor_2 || "-" %></td>
                <td><%= r.observacion %></td>
                <td class="estado">
                  <% if (r.estado === 'COMPLETADO') { %>
                    <span class="badge bg-success">✅</span>
                  <% } else if (r.estado === 'EN_PROCESO') { %>
                    <span class="badge bg-primary">🔄</span>
                  <% } else if (r.estado === 'PENDIENTE') { %>
                    <span class="badge bg-warning text-dark">⏳</span>
                  <% } else { %>
                    <span class="badge bg-secondary">❓</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.archivoPdf) { %>
                    <a href="/reclamos/<%= r.id %>/pdf" class="btn btn-sm btn-success">
                      📄 Descargar
                    </a>
                  <% } else { %>
                    <span class="text-muted">Sin PDF</span>
                  <% } %>
                </td>
                <td>
                  <button type="button" class="btn btn-success btn-sm"
                    onclick='mostrarPopup(JSON.parse(decodeURIComponent("<%= encodeURIComponent(JSON.stringify(r)) %>")))' 
                    aria-label="Ver reclamo <%= r.id %>">
                    Revisar reclamo
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Popup -->
    <div id="popup-reclamo" class="popup-overlay d-none">
      <div class="popup-content">
        <div class="d-flex justify-content-between align-items-start">
          <h5 class="mb-4">Detalles del Reclamo</h5>
          <div class="text-end">
            <p class="mb-1"><strong>Fecha Toma:</strong> <span id="popup-fecha-toma"></span></p>
            <p class="mb-1"><strong>Tomado por:</strong> <span id="popup-usuario-toma"></span></p>
          </div>
          <button type="button" class="btn btn-info w-100 mb-2" id="btn-info-resolucion">
            Revisar resolución
          </button>
        </div>

        <p><strong>Fecha:</strong> <span id="popup-fecha"></span></p>
        <p><strong>ID:</strong> <span id="popup-id"></span></p>
        <p><strong>Cliente:</strong> <span id="popup-cliente"></span></p>
        <p><strong>Nombre:</strong> <span id="popup-nombre"></span></p>
        <p><strong>Teléfono:</strong> <span id="popup-telefono"></span></p>
        <p><strong>Tipo:</strong> <span id="popup-tipo"></span></p>
        <p><strong>Área:</strong> <span id="popup-area"></span></p>
        <p><strong>Factura:</strong> <span id="popup-factura"></span></p>
        <p><strong>Vendedor:</strong> <span id="popup-vendedor"></span></p>
        <p><strong>Observación:</strong> <span class="observacion" id="popup-observacion"></span></p>

        <div class="popup-buttons">
          <form id="popup-form-pendiente" method="POST">
            <input type="hidden" name="endpoint" id="endpoint-pendiente">
            <button type="submit" class="btn btn-warning text-dark w-100">⏳ Pendiente</button>
          </form>
          
          <form id="popup-form-en-proceso" method="POST">
            <input type="hidden" name="endpoint" id="endpoint-en-proceso">
            <button type="submit" class="btn btn-primary w-100">🔄 En proceso</button>
          </form>

          <form id="popup-form-completado" method="POST">
            <input type="hidden" name="endpoint" id="endpoint-completado">
            <button type="submit" class="btn btn-success w-100">✅ Completado</button>
          </form>
          <button type="button" onclick="cerrarPopup('reclamo')" class="btn btn-secondary w-100">❌ Cancelar</button>
        </div>
      </div>
    </div>

    <div id="popup-info-resolucion" class="popup-overlay d-none">
      <div class="popup-content">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h5>📋 Información de Resolución</h5>
        </div>
        
        <div class="d-flex gap-2">
          <form id="guardar-informacion-resolucion" method="POST">
            <textarea id="info-resolucion-text" class="form-control" placeholder="Escribí la información de resolución aquí..."></textarea>
            <button type="submit" class="btn btn-success w-100">Guardar información</button>
          </form>
          <button type="button" onclick="cerrarPopup('info-resolucion')" class="btn btn-secondary">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  </div>
  <script>
    async function mostrarPopup(r) {

      document.getElementById("btn-info-resolucion").onclick = function() {
        mostrarPopupInfoResolucion(r);
      };

      document.getElementById("popup-fecha-toma").textContent = r.fecha_tomado ? r.fecha_tomado.replace("T", " ").split(".")[0] : "no tomado";
      document.getElementById("popup-usuario-toma").textContent = r.tomado_por || "no tomado";
      
      document.getElementById("popup-fecha").textContent = new Date(r.fecha_tiempo).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' });
      document.getElementById("popup-id").textContent = r.id;
      document.getElementById("popup-cliente").textContent = r.cliente || "sin codigo";
      document.getElementById("popup-nombre").textContent = r.maestro_21?.nombre || "sin nombre";
      document.getElementById("popup-telefono").textContent = r.maestro_21?.telefono || "sin telefono";
      document.getElementById("popup-tipo").textContent = r.tipo;
      document.getElementById("popup-area").textContent = r.reclamo_area.map(a => a.area).join(', ');
      document.getElementById("popup-factura").textContent = r.cod_factura || "sin factura";
      document.getElementById("popup-vendedor").textContent = (r.maestro_21?.vendedor_1 || "sin vendedor") + " / " + (r.maestro_21?.vendedor_2 || "sin vendedor");
      document.getElementById("popup-observacion").textContent = r.observacion_completa;

      document.getElementById("popup-form-completado").action = "/reclamos/resolver/" + r.id;
      document.getElementById("popup-form-en-proceso").action = "/reclamos/en_proceso/" + r.id;
      document.getElementById("popup-form-pendiente").action = "/reclamos/pendiente/" + r.id;

      async function setEndpointInputs() {
        const registration = await navigator.serviceWorker.getRegistration();
        if (!registration) return;

        const subscription = await registration.pushManager.getSubscription();
        if (!subscription) return;

        const endpoint = subscription.endpoint;

        document.getElementById("endpoint-en-proceso").value = endpoint;
        document.getElementById("endpoint-completado").value = endpoint;
        document.getElementById("endpoint-pendiente").value = endpoint;
      }

      await setEndpointInputs();


      document.getElementById("popup-reclamo").classList.remove("d-none");
      document.getElementById("popup-reclamo").classList.add("d-flex");
    }

    document.getElementById('reporte').addEventListener('click', () => {
      document.getElementById('popup-reporte').classList.remove('d-none');
      document.getElementById('popup-reporte').classList.add('d-flex');
    });

    document.getElementById('btn-agregar-paso').addEventListener('click', () => {
      document.getElementById('div-pasos').classList.toggle('d-none');
      document.getElementById("popup-info-resolucion").action = "/reclamos/info-resolucion/" + r.id;
    });

    async function mostrarPopupInfoResolucion(r) {
      document.getElementById("popup-info-resolucion").classList.remove("d-none");
      document.getElementById("popup-info-resolucion").classList.add("d-flex");

      const textarea = document.getElementById("info-resolucion-text");
      textarea.value = r.info_resolucion || "";

      document.getElementById("guardar-informacion-resolucion").action = "/reclamos/info-resolucion/" + r.id;
    }

    function cerrarPopup(tipo) {
      if (tipo === 'reporte') {
        document.getElementById('popup-reporte').classList.remove('d-flex');
        document.getElementById('popup-reporte').classList.add('d-none');
      } else if (tipo === 'reclamo') {
        document.getElementById('popup-reclamo').classList.remove('d-flex');
        document.getElementById('popup-reclamo').classList.add('d-none');
      } else if (tipo === 'info-resolucion') {
        document.getElementById('popup-info-resolucion').classList.remove('d-flex');
        document.getElementById('popup-info-resolucion').classList.add('d-none');
      }
    }
  </script>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();

    socket.on("estadoActualizado", (data) => {

      location.reload();
    });
  </script>
</body>
</html>