<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Detalle de Reclamo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>

<body class="text-dark">
  <div class="container my-5">
    <h1 class="text-center fw-bold mb-4">Detalle del Reclamo #<%= reclamo.id %></h1>
    <div class="mt-4 mb-3">
      <a href="/reclamos" class="btn btn-outline-light">Volver</a>
    </div>

    <!-- Datos básicos del reclamo -->
    <div class="card mb-4 shadow-sm">
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <p><strong>Cliente:</strong> <%= reclamo.maestro_21?.nombre || "sin nombre" %></p>
            <p><strong>Teléfono:</strong> <%= reclamo.maestro_21?.telefono || "sin telefono" %></p>
            <p><strong>Área responsable:</strong> <%- reclamo.reclamo_area.map(a => a.area).join(', ') %></p>
            <p><strong>Observación:</strong> <%= reclamo.observacion %></p>
          </div>
          <div class="col-md-6 d-flex justify-content-end align-items-center">
            <% if (reclamo.estado === 'COMPLETADO') { %>
              <span class="badge fs-1">✅</span>
            <% } else if (reclamo.estado === 'EN_PROCESO') { %>
              <span class="badge fs-1">🔄</span>
            <% } else if (reclamo.estado === 'PENDIENTE') { %>
              <span class="badge fs-1">⏳</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Formulario para agregar paso -->
    <div class="card mb-4">
      <div class="card-header text-white" style="background-color: #163b63;">
        ➕ Agregar paso de resolución
      </div>
      <div class="card-body">
       <form method="POST" action="/reclamos/<%= reclamo.id %>/agregar-paso" class="d-flex flex-column gap-3" enctype="multipart/form-data">
        <div>
          <label for="tipo" class="form-label fw-bold">
            Tipo de paso <span style="color:red">*</span>
            <span class="text-secondary opacity-75 ms-1">Tener en cuenta que "Análisis" e "Información" cambiarán el estado del reclamo a "EN PROCESO" mientras que "Finalización" lo cambiará a "COMPLETADO"</span>
          </label>
          <select id="tipo" name="tipo" class="form-select" required>
            <option value="">Seleccionar...</option>
            <option value="ANALISIS">🔍 Análisis</option>
            <option value="INFORMACION">ℹ️ Información</option>
            <option value="FINALIZACION">✅ Finalización</option>
          </select>
        </div>

        <div>
          <label for="descripcion" class="form-label fw-bold">
            Descripción <span style="color:red">*</span>
          </label>
          <textarea id="descripcion" name="descripcion" class="form-control" rows="4" placeholder="Escribe los detalles del paso..." style="border: 1px solid #000" required></textarea>
        </div>

        <div id="resolucion-container" style="display:none;">
          <label for="resolucion" class="form-label fw-bold">
            Resolución del reclamo <span style="color:red">*</span>
          </label>
          <select id="resolucion" name="resolucion" class="form-select w-100">
            <option value="">Selecciona la resolución</option>
            <option value="SE DESESTIMA EL RECLAMO">Se desestima el reclamo</option>
            <option value="SE ENVIA LA MERCADERIA CORRESPONDIENTE">Se envía la mercadería correspondiente</option>
            <option value="SE EFECTUA LA NOTA DE CREDITO">Se efectúa la nota de crédito</option>
            <option value="SE REVISA EXITOSAMENTE LA DIFERENCIA EN CC">Se revisa exitosamente la diferencia en CC</option>
            <option value="SE LE NOTIFICA AL VENDEDOR">Se le notifica al vendedor</option>
            <option value="SE LE HACE EL VALE AL FLETERO">Se le hace el vale al fletero</option>
            <option value="NO HAY ELEMENTOS PARA CORROBORAR LOS HECHOS">No hay elementos para corroborar los hechos</option>
            <option value="SE RETIRA LA MERCADERIA INDICADA POR OR">se retira la mercadería indicada por OR</option>
            <option value="OTRO">Otro</option>
          </select>
        </div>

        <div id="area-container" class="">
          <label for="area" class="form-label fw-bold">Área <span style="color:red">*</span> <span class="text-secondary opacity-75 ms-1">Asegúrese de poner correctamente el área responsable del siguiente paso</span></label>
          <select id="area" name="area" class="form-select w-100" required>
            <option value="">Selecciona el área a notificar</option>
            <option value="VENTAS">Ventas</option>
            <option value="ADMINISTRACION">Administración</option>
            <option value="DEPOSITO">Depósito</option>
            <option value="RRHH">RRHH</option>
          </select>
        </div>

        <div class="">
          <label for="foto" class="form-label fw-bold">Agregar foto</label>
          
          <div id="drop-zone" class="drop-zone" tabindex="0">
            <p id="drop-zone-text">Arrastra una imagen aquí, pégala, o haz clic para seleccionar</p>
            
            <img id="preview-image" src="" alt="Vista previa de la imagen">
            
            <button type="button" id="remove-image" class="btn-close" aria-label="Quitar imagen"></button>
          </div>
          
          <input type="file" id="foto" name="foto" class="form-control" accept="image/*" style="display: none;">
        </div>

        <input type="hidden" name="endpoint" id="endpoint-actual">
        <button type="submit" class="btn btn-success mt-3">💾 Guardar Paso</button>
      </form>
      </div>
    </div>

    <!-- Historial de pasos -->
    <div class="card shadow-sm">
      <div class="card-header bg-secondary text-white">
        📜 Historial de Resolución
      </div>
      <div class="card-body">
        <% if (reclamo.paso && reclamo.paso.length > 0) { %>
          <ul class="list-group">
            <% reclamo.paso.forEach(function(p, index) { %>
              <li class="list-group-item">
                <strong>Paso <%= index + 1 %> - <%= p.tipo %>:</strong> <%= p.descripcion %>  
                
                <% if (p.foto) { %>
                  <br>
                  <!-- Foto clickeable -->
                  <div class="mt-2">
                    <img src="<%= p.foto %>" 
                        alt="Foto del paso <%= index + 1 %>" 
                        class="img-thumbnail cursor-pointer"
                        style="max-width:200px; cursor:pointer;" 
                        onclick="abrirModalFoto('<%= p.foto %>', 'Foto del paso <%= index + 1 %>')">
                  </div>
                <% } %>

                <br>
                <small class="text-muted">
                  Registrado el <%= new Date(p.fecha).toLocaleString('es-AR') %> 
                  por <%= p.persona || "Desconocido" %> de <%= p.area_paso || "Área no especificada" %>
                  <% if (reclamo.paso.info_resolucion) { %> | Resolución: <em><%= reclamo.paso.info_resolucion %></em> <% } %>
                </small>
              </li>
            <% }) %>
          </ul>

          <% if (reclamo.info_resolucion) { %>
            <div class="alert alert-success mt-3">
              <strong>🟩 Resolución final:</strong> <em><%= reclamo.info_resolucion %></em>
            </div>
          <% } %>
        <% } else { %>
          <p class="text-muted">Todavía no hay pasos registrados.</p>
        <% } %>
      </div>
    </div>

    <!-- Botón volver -->
    <div class="mt-4 mb-3">
      <a href="/reclamos" class="btn btn-outline-light">Volver</a>
    </div>
  </div>

  <div class="modal fade" id="modalFoto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalFotoTitle">Foto</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body text-center">
          <img id="modalFotoImg" src="" class="img-fluid rounded" alt="Foto ampliada">
        </div>
      </div>
    </div>
  </div>

  <script>
    function abrirModalFoto(src, title) {
      document.getElementById('modalFotoImg').src = src;
      document.getElementById('modalFotoTitle').textContent = title;
      
      const modal = new bootstrap.Modal(document.getElementById('modalFoto'));
      modal.show();
    }

    document.addEventListener('DOMContentLoaded', () => {
      const dropZone = document.getElementById('drop-zone');
      const hiddenInput = document.getElementById('foto');
      const previewImage = document.getElementById('preview-image');
      const dropZoneText = document.getElementById('drop-zone-text');
      const removeButton = document.getElementById('remove-image');

      // --- Funciones principales ---

      // Función para manejar el archivo (ya sea soltado, pegado o seleccionado)
      function handleFile(file) {
        if (file && file.type.startsWith('image/')) {
          // Asigna el archivo al input oculto
          // Usamos DataTransfer para poder asignar el archivo al 'files' del input
          const dataTransfer = new DataTransfer();
          dataTransfer.items.add(file);
          hiddenInput.files = dataTransfer.files;

          // Muestra la vista previa
          const reader = new FileReader();
          reader.onload = (e) => {
            previewImage.src = e.target.result;
            previewImage.style.display = 'block';
            removeButton.style.display = 'block';
            dropZoneText.style.display = 'none';
          };
          reader.readAsDataURL(file);
        } else {
          alert("Por favor, selecciona o suelta solo archivos de imagen.");
        }
      }

      // Función para resetear la zona
      function resetDropZone() {
        hiddenInput.value = ''; // Limpia el input
        previewImage.src = '';
        previewImage.style.display = 'none';
        removeButton.style.display = 'none';
        dropZoneText.style.display = 'block';
      }

      // --- Asignación de Eventos ---

      // 1. Clic: Abre el selector de archivos
      dropZone.addEventListener('click', () => {
        hiddenInput.click();
      });

      // 2. Change (cuando se selecciona un archivo)
      hiddenInput.addEventListener('change', () => {
        if (hiddenInput.files.length > 0) {
          handleFile(hiddenInput.files[0]);
        }
      });

      // 3. Drag (Arrastrar sobre la zona)
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault(); // Previene el comportamiento por defecto
        dropZone.classList.add('drag-over');
      });

      // 4. Drag (Salir de la zona)
      dropZone.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
      });

      // 5. Drop (Soltar el archivo)
      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        
        if (e.dataTransfer.files.length > 0) {
          handleFile(e.dataTransfer.files[0]);
        }
      });

      // 6. Paste (Pegar desde el portapapeles)
      // Se asigna a la 'dropZone' (con tabindex="0" se puede "focusear")
      dropZone.addEventListener('paste', (e) => {
        e.preventDefault();
        
        if (e.clipboardData.files.length > 0) {
          handleFile(e.clipboardData.files[0]);
        }
      });

      // 7. Clic en "Quitar imagen"
      removeButton.addEventListener('click', (e) => {
        e.stopPropagation(); // Evita que se dispare el 'click' del dropZone
        resetDropZone();
      });

      resetDropZone();
    });

    document.getElementById("tipo").addEventListener("change", function() {
      const resolucionContainer = document.getElementById("resolucion-container");
      const resolucionInput = document.getElementById("resolucion");
      const areaContainer = document.getElementById("area-container");
      const areaInput = document.getElementById("area");

      if (this.value === "FINALIZACION") {
        resolucionContainer.style.display = "block";
        areaContainer.style.display = "none";
        resolucionInput.required = true;
        areaInput.required = false;
        areaInput.value = "";
      } else {
        resolucionContainer.style.display = "none";
        areaContainer.style.display = "block";
        resolucionInput.required = false;
        areaInput.required = true;
        resolucionInput.value = "";
      }
    });

    async function setEndpointInputs() {
//      const registration = await navigator.serviceWorker.getRegistration();
//      if (!registration) return;

//      const subscription = await registration.pushManager.getSubscription();
//      if (!subscription) return;

//      const endpoint = subscription.endpoint;

      document.getElementById("endpoint-actual").value = "https://fcm.googleapis.com/fcm/send/dbAsF8cJNQQ:APA91bGfqSeE_lHhqHHVFTEY4TZDcJrT2EWvbG2xj3RhacBUdFOulwizLO7CmMaKtPYUfvjcOwAhE20gssKkg44JHviiMmZdiaKEEks9FUuKM2ev-1GXAALcfsX1Tp5kg_mumWYpGRAy"; //endpoint;
    }

    setEndpointInputs();

  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();

    socket.on("estadoActualizado", (data) => {

      location.reload();
    });
  </script>
</body>
</html>
